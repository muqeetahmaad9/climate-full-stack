# Copy this file to .env and fill in real values before running.
# docker-compose overrides MONGO_URI and REDIS_URI automatically.

# ── MongoDB ──────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/pakclim

# ── Redis ────────────────────────────────────────────────────────
REDIS_URI=redis://localhost:6379

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── Rate limits (requests per 60s window) ────────────────────────
RATE_LIMIT_AUTH=5
RATE_LIMIT_DB_QUERY=60

# ── Mapbox (required for the map) ────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

# ── App ──────────────────────────────────────────────────────────
ENVIRONMENT=production
