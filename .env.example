# Copy this to .env and fill in real values before running docker-compose

# ── MongoDB (overridden by docker-compose to internal URL) ──────
MONGO_URI=mongodb://mongo:27017/pakclim

# ── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── Rate Limits (requests per 60s window) ───────────────────────
RATE_LIMIT_LIVE_API=30
RATE_LIMIT_NASA_API=10
RATE_LIMIT_DB_QUERY=60
RATE_LIMIT_AUTH=5

# ── SQLite DB path inside container ─────────────────────────────
SQLITE_DB_PATH=/data/weather_data.db

# ── Next.js frontend build arg ───────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoibmVvYzIwMjMiLCJhIjoiY2x1aTBubHAwMjYzOTJqcGc2cGFhMHU2ciJ9.tFU9_qFCY02qCvfiPMPDUg

# ── App ──────────────────────────────────────────────────────────
ENVIRONMENT=production
