# Copy this to .env and fill in your values

# MongoDB
MONGO_URI=mongodb://mongo:27017/pakclim

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Rate Limits (requests per window)
RATE_LIMIT_LIVE_API=30          # Open-Meteo calls per minute per user
RATE_LIMIT_NASA_API=10          # NASA POWER calls per minute per user
RATE_LIMIT_DB_QUERY=60          # SQLite DB queries per minute per user
RATE_LIMIT_AUTH=5               # Auth endpoint calls per minute per IP

# SQLite DB path (inside container)
SQLITE_DB_PATH=/data/weather_data.db

# App
ENVIRONMENT=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
